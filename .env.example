# ─── Supabase x Claude Café — environment variables ───
# Copy to .env (never commit .env). Every variable is optional:
# without them the game still runs (offline Claude fallback, no persistence).

# ── Server-only (NEVER exposed to the browser) ──
# Anthropic API key — powers the real Claude agent.
# Get it: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
# Model used by the agent (optional).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase service-role key — server-side writes (sessions, rounds, agent memory, results).
# Get it: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Project URL (server). Same value as VITE_SUPABASE_URL.
SUPABASE_URL=

# ── Public (safe for the browser; used only for the Realtime leaderboard) ──
# Supabase Dashboard → Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
